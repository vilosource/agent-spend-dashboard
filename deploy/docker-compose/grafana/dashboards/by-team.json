{
   "title": "Agent Spend — By Team",
   "uid": "agent-spend-by-team",
   "tags": ["agent-spend", "team"],
   "timezone": "browser",
   "schemaVersion": 39,
   "version": 1,
   "refresh": "30s",
   "time": { "from": "now-7d", "to": "now" },
   "templating": {
      "list": [
         {
            "name": "team",
            "label": "Team",
            "type": "query",
            "datasource": { "type": "postgres", "uid": "agent_spend" },
            "query": "SELECT DISTINCT team FROM agent_spend_logs WHERE team IS NOT NULL ORDER BY 1",
            "refresh": 1,
            "current": { "text": "All", "value": "$__all" },
            "includeAll": true,
            "multi": true
         }
      ]
   },
   "panels": [
      {
         "id": 1,
         "type": "barchart",
         "title": "Cost by team (selected window)",
         "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
         "datasource": { "type": "postgres", "uid": "agent_spend" },
         "fieldConfig": {
            "defaults": { "unit": "currencyUSD", "decimals": 2 }
         },
         "targets": [
            {
               "rawSql": "SELECT team, SUM(cost_total_usd) AS cost FROM agent_spend_logs WHERE $__timeFilter(ts) AND team IN ($team) GROUP BY team ORDER BY cost DESC",
               "format": "table"
            }
         ]
      },
      {
         "id": 2,
         "type": "barchart",
         "title": "Active developers by team",
         "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
         "datasource": { "type": "postgres", "uid": "agent_spend" },
         "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
         "targets": [
            {
               "rawSql": "SELECT team, COUNT(DISTINCT user_id) AS developers FROM agent_spend_logs WHERE $__timeFilter(ts) AND team IN ($team) GROUP BY team ORDER BY developers DESC",
               "format": "table"
            }
         ]
      },
      {
         "id": 3,
         "type": "timeseries",
         "title": "Daily cost — per team",
         "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
         "datasource": { "type": "postgres", "uid": "agent_spend" },
         "fieldConfig": {
            "defaults": { "unit": "currencyUSD", "custom": { "drawStyle": "line", "stacking": { "mode": "none" } } }
         },
         "targets": [
            {
               "rawSql": "SELECT date_trunc('day', ts) AS time, team AS metric, SUM(cost_total_usd) AS value FROM agent_spend_logs WHERE $__timeFilter(ts) AND team IN ($team) GROUP BY 1, 2 ORDER BY 1",
               "format": "time_series"
            }
         ]
      },
      {
         "id": 4,
         "type": "table",
         "title": "Per-developer breakdown (within selected teams)",
         "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
         "datasource": { "type": "postgres", "uid": "agent_spend" },
         "fieldConfig": {
            "defaults": { "custom": { "align": "auto" } },
            "overrides": [
               { "matcher": { "id": "byName", "options": "cost_usd" },
                 "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 4 }] }
            ]
         },
         "targets": [
            {
               "rawSql": "SELECT user_id, team, COUNT(*) AS turns, SUM(input_tokens + output_tokens) AS tokens, SUM(cost_total_usd) AS cost_usd FROM agent_spend_logs WHERE $__timeFilter(ts) AND team IN ($team) GROUP BY 1, 2 ORDER BY cost_usd DESC",
               "format": "table"
            }
         ]
      }
   ]
}
