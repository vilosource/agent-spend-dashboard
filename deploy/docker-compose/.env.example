# Example environment for the deploy/docker-compose recipe.
# Copy to .env and fill in real values for a production deployment.
# The lab uses sensible defaults via compose.override.yml; you don't
# need to copy this for local lab work.

# Postgres
POSTGRES_USER=agent_spend
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent_spend
POSTGRES_PORT=5432

# OTel Collector ingest auth — comma-separated bearer tokens
# (one per developer / team / CI account). Empty = no auth.
OTEL_INGEST_TOKENS=

# Optional: Prometheus remote-write target (for a deploying organization
# that has an existing Prometheus / Mimir / Grafana stack). If unset, the
# Collector skips the prometheus exporter.
PROMETHEUS_REMOTE_WRITE_URL=
PROMETHEUS_REMOTE_WRITE_TOKEN=

# Optional: OTLP traces target (e.g. Tempo). If unset, traces are stored
# in Postgres only.
TRACES_OTLP_ENDPOINT=
TRACES_OTLP_TOKEN=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ANONYMOUS=false

# Auth — the API is a pure OAuth 2.0 resource server: it verifies the
# IdP-issued access token on every request and issues nothing itself, so
# there is no JWT-signing secret and no OIDC client secret here. The
# TOKEN_TRACKER_* prefix avoids clashing with generic names other apps
# on the same host might use. See docs/design/token-tracker-redesign-DESIGN.md
# §4 for the auth model.
#
# TOKEN_TRACKER_OIDC_ISSUER_URL — the OIDC provider's issuer URL, e.g.
#   https://login.microsoftonline.com/<tenant-id>/v2.0 for Entra.
#   Discovery (/.well-known/openid-configuration) and the JWKs endpoint
#   are derived from it.
# TOKEN_TRACKER_OIDC_CLIENT_ID — the API's app-registration client id;
#   access tokens must carry this as their `aud` claim.
TOKEN_TRACKER_OIDC_ISSUER_URL=
TOKEN_TRACKER_OIDC_CLIENT_ID=
