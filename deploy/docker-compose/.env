# Lab defaults loaded automatically by compose. Per the boundary policy, these are
# intentionally insecure example values for local development only. Do NOT use these
# in any deployed environment.
POSTGRES_USER=token_tracker
POSTGRES_PASSWORD=dev
POSTGRES_DB=token_tracker

# Grafana lab defaults — overridden by compose.override.yml
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS=true

# OIDC / auth lab defaults. The override sets identical values; these
# exist in the base .env so `compose.yml` can satisfy its `${VAR:?...}`
# required-variable check without the override loaded (e.g. when
# tooling parses compose.yml in isolation).
AGENT_SPEND_JWT_SECRET=lab-jwt-secret-not-for-production
AGENT_SPEND_OIDC_ISSUER_URL=http://idp.localhost:7019
AGENT_SPEND_OIDC_CLIENT_ID=agent-spend
AGENT_SPEND_OIDC_CLIENT_SECRET=lab-secret
