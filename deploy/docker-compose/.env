# Lab defaults loaded automatically by compose. Per the boundary policy, these are
# intentionally insecure example values for local development only. Do NOT use these
# in any deployed environment.
POSTGRES_USER=token_tracker
POSTGRES_PASSWORD=dev
POSTGRES_DB=token_tracker

# Grafana lab defaults — overridden by compose.override.yml
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS=true

# OIDC lab defaults. The override sets identical values; these exist in the
# base .env so `compose.yml` can satisfy its `${VAR:?...}` required-variable
# checks without the override loaded (e.g. when tooling parses compose.yml in
# isolation). The server is a pure resource server — no client secret, no
# JWT-signing secret. The lab IdP (lab/idp/) issues access tokens with
# aud=token-tracker-api.
TOKEN_TRACKER_OIDC_ISSUER_URL=http://idp.localhost:7019
TOKEN_TRACKER_OIDC_CLIENT_ID=token-tracker-api
